{
  "name": "labor-cue-app",
  "version": "1.0.0",
  "description": "A mobile app for tracking maternal HRV to detect potential preterm labor indicators",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node scripts/clean-coverage.js && jest --passWithNoTests --coverage",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "verify": "npm run lint && npm test",
    "clean:build": "node scripts/clean-build.js",
    "build": "npm run clean:build && expo export",
    "build:clean": "npm run clean:build",
    "verify:unix": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^6.6.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "date-fns": "^3.2.0",
    "expo": "^54.0.34",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "simple-statistics": "^7.8.9",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "metro": "^0.83.1",
    "metro-cache": "^0.83.1",
    "metro-cache-key": "^0.83.1",
    "metro-config": "^0.83.1",
    "metro-runtime": "^0.83.1",
    "metro-source-map": "^0.83.1",
    "metro-transform-plugins": "^0.83.1",
    "metro-transform-worker": "^0.83.1",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "fast-xml-parser": "5.3.4"
  },
  "private": true
}
